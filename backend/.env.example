# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave MONGODB_URI empty to automatically use local JSON file database fallback (backend/data/db.json)
MONGODB_URI=

# Speech-to-Text Configuration
# AssemblyAI API Key (Get a free key from https://www.assemblyai.com)
# Leave empty to use contextual mock/demo mode for zero-setup local testing!
ASSEMBLYAI_API_KEY=

# (Optional) OpenAI API Key if you want to use Whisper API
OPENAI_API_KEY=

# Authentication Configuration
JWT_SECRET=voxscribe_super_secret_session_key

# Google OAuth Configuration
# Generate a Google Client ID from Google Cloud Console (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=
